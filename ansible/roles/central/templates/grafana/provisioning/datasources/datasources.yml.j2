apiVersion: 1

# Grafana habla con Mimir/Loki EN DIRECTO por la red interna de Docker
# Compose (no a través del proxy 443: no es un cliente, es parte de la
# infraestructura central de confianza). El tenant lo fija la cabecera
# X-Scope-OrgID de cada datasource, configurada aquí en el servidor y
# nunca visible desde el navegador (access: proxy).
#
# Dos backends, cuatro datasources: cada tenant se consulta explícitamente
# por su propio datasource, sin depender de ninguna federación entre
# tenants (las etiquetas cliente=... no sustituyen este aislamiento).
datasources:
{% for tenant in lab.tenants %}
{% set etiqueta = "Cliente " ~ (tenant.split('-')[1] | upper) %}
  - name: "Mimir · {{ etiqueta }}"
    uid: "mimir-{{ tenant }}"
    type: prometheus
    access: proxy
    url: http://mimir:9009/prometheus
    isDefault: false
    editable: false
    jsonData:
      httpHeaderName1: "X-Scope-OrgID"
    secureJsonData:
      httpHeaderValue1: "{{ tenant }}"

  - name: "Loki · {{ etiqueta }}"
    uid: "loki-{{ tenant }}"
    type: loki
    access: proxy
    url: http://loki:3100
    isDefault: false
    editable: false
    jsonData:
      httpHeaderName1: "X-Scope-OrgID"
    secureJsonData:
      httpHeaderValue1: "{{ tenant }}"
{% endfor %}
