# Gestionado por Ansible (rol "central"). No editar a mano.
#
# Modo monolítico con multitenancy (auth_enabled) activada. Backend de
# almacenamiento: filesystem, misma decisión y mismas razones que en Mimir
# (ver mimir.yaml.j2 y el README): instancia única, sin necesidad de S3/MinIO.
auth_enabled: true

server:
  http_listen_port: 3100
  grpc_listen_port: 9096

common:
  path_prefix: /data
  storage:
    filesystem:
      chunks_directory: /data/chunks
      rules_directory: /data/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: "2024-01-01"
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

compactor:
  working_directory: /data/compactor
  retention_enabled: true
  delete_request_store: filesystem

# Límites explícitos y finitos: la retención de logs (7 días) y las tasas
# de ingesta por stream son los "límites de los buffers" que la
# validación #7 comprueba tras restaurar un gateway caído. No hay
# recuperación ilimitada de historial.
limits_config:
  reject_old_samples: true
  reject_old_samples_max_age: 168h
  retention_period: 168h
  ingestion_rate_mb: 8
  ingestion_burst_size_mb: 16
  per_stream_rate_limit: 5MB
  per_stream_rate_limit_burst: 10MB
  max_query_series: 5000

analytics:
  reporting_enabled: false
